@model IReadOnlyList<CatalogRow>
@{ var kind = (string)ViewBag.Kind; ViewData["Title"] = (string)ViewBag.Title; }
<div class="hero-row compact-hero"><div><div class="eyebrow">ДОВІДКОВІ ДАНІ</div><h1>@ViewBag.Title</h1><p class="muted">Каталогові моделі можна створювати, редагувати та видаляти.</p></div><a class="button button-primary" asp-action="Create" asp-route-kind="@kind">＋ Додати запис</a></div>
<div class="catalog-tabs"><a class="@(kind == "inspectors" ? "active" : "")" asp-route-kind="inspectors">Інспектори</a><a class="@(kind == "vehicles" ? "active" : "")" asp-route-kind="vehicles">Транспорт</a><a class="@(kind == "articles" ? "active" : "")" asp-route-kind="articles">Статті порушень</a></div>
<div class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>НАЗВА / ІДЕНТИФІКАТОР</th><th>ОСНОВНІ ДАНІ</th><th>ДЕТАЛІ</th>@if(kind == "articles"){<th>САНКЦІЯ</th>}@if(kind == "vehicles"){<th>РІК</th>}<th></th></tr></thead><tbody>
@foreach(var row in Model){<tr><td><strong>@row.Name</strong><small>ID @row.Id</small></td><td>@row.Sub</td><td>@(row.Extra ?? "—")</td>@if(kind == "articles"){<td><strong>@row.Amount?.ToString("N0", CultureInfo.GetCultureInfo("uk-UA")) ₴</strong></td>}@if(kind == "vehicles"){<td>@(row.Year?.ToString() ?? "—")</td>}<td class="row-actions"><a class="text-link" asp-action="Edit" asp-route-kind="@kind" asp-route-id="@row.Id">Редагувати</a><a class="icon-link" asp-action="Delete" asp-route-kind="@kind" asp-route-id="@row.Id" aria-label="Видалити">×</a></td></tr>}
</tbody></table></div>@if(Model.Count == 0){<div class="empty-state"><span>＋</span><strong>Довідник поки порожній</strong></div>}</div>
