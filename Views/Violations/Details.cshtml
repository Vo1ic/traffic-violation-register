@model Violation
@{ ViewData["Title"] = "Картка справи"; var fine = Model.Articles.Sum(x => x.FineAmount); }
<div class="hero-row compact-hero"><div><div class="eyebrow">КАРТКА МАТЕРІАЛІВ</div><h1>@Model.CaseNumber</h1><p class="muted">Зареєстровано @Model.OccurredAt.ToString("dd MMMM yyyy, HH:mm", CultureInfo.GetCultureInfo("uk-UA"))</p></div><div class="hero-actions"><a class="button button-light" asp-action="Index">← До реєстру</a><a class="button button-primary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a></div></div>
<div class="detail-layout"><section class="panel detail-panel"><div class="detail-heading"><div><div class="eyebrow">ОБСТАВИНИ</div><h2>Інформація про порушення</h2></div><span class="status status-@Model.Status.ToString().ToLowerInvariant()">@Html.DisplayFor(x => x.Status)</span></div>
    <div class="detail-grid"><div><small>Водій</small><strong>@Model.DriverName</strong></div><div><small>Транспортний засіб</small><strong>@Model.Vehicle?.PlateNumber · @Model.Vehicle?.MakeModel</strong></div><div><small>Місце</small><strong>@Model.Location</strong></div><div><small>Рік випуску авто</small><strong>@(Model.Vehicle?.Year?.ToString() ?? "Не вказано")</strong></div><div class="detail-wide"><small>Опис події</small><p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Обставини не додано." : Model.Description)</p></div></div>
</section>
<section class="panel detail-panel"><div class="eyebrow">УЧАСНИКИ ТА КВАЛІФІКАЦІЯ</div><h2>Інспектори</h2><div class="people-list">@foreach(var o in Model.Inspectors){<div class="person-row"><span class="avatar avatar-blue">@o.FullName[..1]</span><span><strong>@o.FullName</strong><small>@o.Rank · №@o.BadgeNumber</small></span><small>@o.Unit</small></div>}</div><h2 class="subsection-title">Статті порушення</h2><div class="article-list">@foreach(var a in Model.Articles){<div class="article-line"><span><b>@a.Code</b><strong>@a.Title</strong><small>@a.Category</small></span><b>@a.FineAmount.ToString("N0", CultureInfo.GetCultureInfo("uk-UA")) ₴</b></div>}</div><div class="fine-total"><span>Сума за статтями</span><strong>@fine.ToString("N0", CultureInfo.GetCultureInfo("uk-UA")) грн</strong></div></section></div>
<div class="danger-zone"><span>Потрібно прибрати помилкову справу?</span><a asp-action="Delete" asp-route-id="@Model.Id">Видалити запис</a></div>
